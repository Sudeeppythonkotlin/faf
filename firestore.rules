rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write only their OWN doc. No listing or enumeration.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.ageConfirmed == true
        && request.resource.data.accountStatus == 'active';
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.ageConfirmed == true
        && (!('age' in request.resource.data) || request.resource.data.age >= 18)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 100)
        && (!('interests' in request.resource.data) || request.resource.data.interests.size() <= 8);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
