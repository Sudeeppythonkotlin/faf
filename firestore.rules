rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Private account data: owner only ----
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.ageConfirmed == true
        && request.resource.data.accountStatus == 'active';
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.ageConfirmed == true
        && (!('age' in request.resource.data) || request.resource.data.age >= 18)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 100)
        && (!('interests' in request.resource.data) || request.resource.data.interests.size() <= 8);
      allow delete: if false;

      match /socials/{platform} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && platform in ['instagram', 'snapchat', 'linkedin', 'discord']
          && request.resource.data.handle is string
          && request.resource.data.handle.size() <= 100
          && request.resource.data.visible is bool;
      }
      // discovery history (30-day cooldown) and my block list: owner only
      match /seen/{other} { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /blocks/{other} { allow read, write: if request.auth != null && request.auth.uid == uid; }
      // "someone blocked me" markers: anyone signed in can add/remove only THEIR OWN marker; I can read mine
      match /blockedBy/{blocker} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if request.auth != null && request.auth.uid == blocker;
      }
    }

    // ---- Public discovery cards: what other students may see ----
    match /pool/{uid} {
      allow get: if request.auth != null;
      // lists must be small (max 60 cards per query)
      allow list: if request.auth != null && request.query.limit <= 60;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == 'active'
        && get(/databases/$(database)/documents/users/$(uid)).data.discoverable == true
        && request.resource.data.age >= 18
        && request.resource.data.keys().hasOnly(['displayName','age','collegeName','universityId','stateId','interests','avatarConfig','bio','socials','rand','updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
