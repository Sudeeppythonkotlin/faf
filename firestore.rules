rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return request.auth != null && request.auth.uid == uid; }

    // ---- Private user record: owner only, no listing ----
    match /users/{uid} {
      allow get: if isMe(uid);
      allow list: if false;
      allow create: if isMe(uid)
        && request.resource.data.ageConfirmed == true
        && request.resource.data.accountStatus == 'active';
      allow update: if isMe(uid)
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.ageConfirmed == true
        && (!('age' in request.resource.data) || request.resource.data.age >= 18)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 100)
        && (!('interests' in request.resource.data) || request.resource.data.interests.size() <= 8);
      allow delete: if false;

      match /socials/{platform} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && platform in ['instagram', 'snapchat', 'linkedin', 'discord']
          && request.resource.data.handle is string
          && request.resource.data.handle.size() <= 100
          && request.resource.data.visible is bool;
      }
      // who I have already discovered (30-day cooldown)
      match /discoveries/{other} {
        allow read, write: if isMe(uid);
      }
      // people I blocked
      match /blocked/{other} {
        allow read, write: if isMe(uid);
      }
      // people who blocked me (they write the marker, I read it)
      match /blockedBy/{blocker} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(blocker);
      }
    }

    // ---- Public discovery copy: safe fields only. Reads are small (max 8 per query). ----
    match /pool/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 8;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['displayName','age','collegeName','universityId','stateId','avatarConfig','interests','bio','rand','active','socials','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 30
        && request.resource.data.age is int && request.resource.data.age >= 18
        && request.resource.data.interests.size() <= 8
        && request.resource.data.bio.size() <= 100
        && request.resource.data.rand is number && request.resource.data.rand >= 0 && request.resource.data.rand <= 1
        && request.resource.data.universityId == get(/databases/$(database)/documents/users/$(uid)).data.universityId
        && request.resource.data.active == (get(/databases/$(database)/documents/users/$(uid)).data.discoverable == true
             && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus == 'active');
      allow delete: if isMe(uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
